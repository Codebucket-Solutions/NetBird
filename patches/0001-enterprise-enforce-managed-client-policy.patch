+
+// trackWindow records when a window's webview has loaded and forgets the
+// window once it closes. OnCreate fires before the window is run, so the
+// runtime-ready event is never missed.
+func (t *Theme) trackWindow(w application.Window) {
+	id := w.ID()
+	w.OnWindowEvent(events.Common.WindowRuntimeReady, func(*application.WindowEvent) {
+		t.readyMu.Lock()
+		t.ready[id] = struct{}{}
+		t.readyMu.Unlock()
+	})
+	w.OnWindowEvent(events.Common.WindowClosing, func(*application.WindowEvent) {
+		t.readyMu.Lock()
+		delete(t.ready, id)
+		t.readyMu.Unlock()
+	})
+}
+
+func (t *Theme) isReady(id uint) bool {
+	t.readyMu.Lock()
+	defer t.readyMu.Unlock()
+	_, ok := t.ready[id]
+	return ok
+}
